# ============================================================
# 提示词工坊 环境配置模板
# 使用方法: 复制本文件为 config/.env 并填入你自己的配置
#   cp config/.env.example config/.env
# ============================================================

# ---------- LLM 配置（任意 OpenAI 兼容接口） ----------
# API 地址，例如:
#   OpenAI:   https://api.openai.com/v1/chat/completions
#   DeepSeek: https://api.deepseek.com/v1/chat/completions
#   302.ai:   https://api.302.ai/v1/chat/completions
#   Ollama:   http://localhost:11434/v1/chat/completions
API_URL=https://api.openai.com/v1/chat/completions
# 你的 LLM API Key
API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# 默认模型
MODEL_NAME=gpt-4o-mini
# 前端可选模型列表（格式: model_id:显示名称，多个用英文逗号分隔）
AVAILABLE_MODELS=gpt-4o-mini:gpt-4o-mini,gpt-4o:gpt-4o

# ---------- Supabase 配置（必填） ----------
# 在 https://supabase.com 免费创建项目后，从 Project Settings -> API 获取
# 数据库建表 SQL 见 docs/supabase_setup.sql
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- 可选配置 ----------
# 跨域来源白名单（前后端分开部署时才需要；多个来源用英文逗号分隔，默认仅同源）
# ALLOWED_ORIGINS=https://your-frontend.example.com
# 旧版本地令牌签名密钥（不设置则每次启动随机生成，重启后旧令牌失效）
# 生成方式: openssl rand -hex 32
# SECRET_KEY=
# 服务端口（默认 8000，被占用时自动换端口）
# PORT=8000
# 日志级别（默认: 本地 DEBUG，Vercel 上 INFO）
# LOG_LEVEL=INFO
