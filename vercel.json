{
  "version": 2,
  "builds": [
    {
      "src": "prompt_generator/server.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.9",
        "installCommand": "pip install --no-cache-dir -r requirements.txt",
        "excludeFiles": ["**/uuid.py", "prompt_generator/uuid.py", "uuid.py"],
        "includeFiles": ["prompt_generator/monkeypatch.py"],
        "maxLambdaSize": "50mb"
      }
    },
    {
      "src": "prompt_generator/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/prompt_generator/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/prompt_generator/server.py"
    }
  ],
  "github": {
    "silent": true,
    "autoJobCancelation": true
  }
} 